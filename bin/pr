#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup" if File.exist?(File.expand_path("../Gemfile", __dir__))
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "switchyard"

if ARGV.first =~ /\A(-h|--help|help)\z/
  puts "Usage: pr [number] [deploy|console|logs|migrate|restore <from>|list]"
  exit 0
end

Switchyard::CLI.start(["pr"] + ARGV)
